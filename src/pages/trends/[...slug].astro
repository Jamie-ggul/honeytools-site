---
import { getCollection } from 'astro:content';
import TrendLayout from '../../layouts/TrendLayout.astro';

export async function getStaticPaths() {
  const trends = await getCollection('trends', ({ data }) => !data.draft);
  return trends.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const all = await getCollection('trends', ({ data }) => !data.draft);
const overlap = (tags: string[]) => tags.filter((t) => t !== 'AI Trends' && entry.data.tags.includes(t)).length;
const related = all
  .filter((t) => t.slug !== entry.slug)
  .sort((a, b) => overlap(b.data.tags) - overlap(a.data.tags) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<TrendLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <Content />
  <section class="related">
    <h2>More AI Trends</h2>
    <div class="card-grid">
      {related.map((t) => (
        <a class="card" href={`/trends/${t.slug}/`}>
          <h3>{t.data.title}</h3>
        </a>
      ))}
    </div>
    <p><a href="/trends/">All AI Trends</a> · <a href="/tools/llm-api-cost-calculator/">Free LLM API cost calculator</a></p>
  </section>
</TrendLayout>
