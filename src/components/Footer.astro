---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap-wide bar">
    <p class="muted">© {year} HoneyTools. Honest, hands-on reviews of AI &amp; SaaS tools.</p>
    <p class="muted small">
      Some links on this site are affiliate links — see our
      <a href="/about/#disclosure">disclosure</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }
  .bar {
    padding: 1.5rem 1.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .small {
    font-size: 0.85rem;
  }
</style>
